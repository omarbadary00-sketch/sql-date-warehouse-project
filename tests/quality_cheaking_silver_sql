-- ====================================================================
-- Quality Checks: bronze.crm_sales_details
-- ====================================================================
print ' ====================================================================';
PRINT 'Checking: bronze.crm_sales_details - Invalid sls_order_dt';
print ' ====================================================================';
select
    nullif(sls_order_dt, 0) as sls_order_dt
from bronze.crm_sales_details
where sls_order_dt <= 0                    
   or len(sls_order_dt) != 8               
   or sls_order_dt > 20500101               
   or sls_order_dt < 19000101;            


-- ====================================================================
-- Quality Checks: silver.crm_cust_info
-- ====================================================================
print ' ====================================================================';
PRINT 'Checking: silver.crm_cust_info - Duplicate or null cst_id';
print ' ====================================================================';
select 
    cst_id,
    count(*) as cnt
from silver.crm_cust_info
group by cst_id
having count(*) > 1 or cst_id is null;

PRINT 'Checking: silver.crm_cust_info - Unwanted spaces in cst_firstname';
select cst_firstname
from silver.crm_cust_info
where cst_firstname != trim(cst_firstname);

PRINT 'Checking: silver.crm_cust_info - Unwanted spaces in cst_lastname';
select cst_lastname
from silver.crm_cust_info
where cst_lastname != trim(cst_lastname);

PRINT 'Checking: silver.crm_cust_info - Standardized cst_marital_status values';
select distinct cst_marital_status
from silver.crm_cust_info;

PRINT 'Checking: silver.crm_cust_info - Standardized cst_gndr values';
select distinct cst_gndr
from silver.crm_cust_info;

PRINT 'Checking: silver.crm_cust_info - Invalid or missing cst_create_date';
select *
from silver.crm_cust_info
where cst_create_date is null
   or cst_create_date > getdate();


-- ====================================================================
-- Quality Checks: silver.erp_cust_az12
-- ====================================================================
print ' ====================================================================';
PRINT 'Checking: silver.erp_cust_az12 - Leftover NAS prefix in CID';
print ' ====================================================================';
select CID
from silver.erp_cust_az12
where CID like 'NAS%';

PRINT 'Checking: silver.erp_cust_az12 - Unwanted spaces in CID';
select CID
from silver.erp_cust_az12
where CID != trim(CID);

PRINT 'Checking: silver.erp_cust_az12 - Out-of-range BDATE';
select BDATE
from silver.erp_cust_az12
where BDATE > getdate()
   or BDATE < '1900-01-01';

PRINT 'Checking: silver.erp_cust_az12 - Standardized GEN values';
select distinct GEN
from silver.erp_cust_az12;

PRINT 'Checking: silver.erp_cust_az12 - Orphan CID not found in silver.crm_cust_info';
select CID
from silver.erp_cust_az12
where CID not in (
    select cst_key from silver.crm_cust_info
);
