
/*
=============================================================================
Quality Checks
=============================================================================
Script Purpose:
    This script performs various quality checks for data consistency, accuracy, 
    and standardization across the 'silver' schemas. It includes checks for:
    - Null or duplicate primary keys.
    - Unwanted spaces in string fields.
    - Data standardization and consistency.
    - Invalid date ranges and orders.
    - Data consistency between related fields.

Usage Notes:
    - Run these checks after data loading Silver Layer.
    - Investigate and resolve any discrepancies found during the checks.
=============================================================================
*/

 --====================================================================
 --Quality Checks: bronze.crm_pro_info'
 --====================================================================
print ' ====================================================================';
PRINT ' Checking: bronze.crm_pro_info - Duplicate prd_id';
print ' ====================================================================';
select 
    prd_id,
    count(*) as cnt          
from bronze.crm_pro_info
where prd_id is not null    
group by prd_id
having count(*) > 1          
order by prd_id;


-- ====================================================================
-- Quality Checks: bronze.erp_loc101
-- ====================================================================
print ' ====================================================================';
PRINT 'Checking: bronze.erp_loc101 - CID issues (duplicates, nulls, blanks, spaces)';
print ' ====================================================================';
select
    CID,
    count(*) as cnt
from bronze.erp_loc101
group by CID
having count(*) > 1       
    or CID is null          
    or trim(CID) = ''       
    or CID != trim(CID);    

PRINT 'Checking: bronze.erp_loc101 - Unexpected CNTRY values';
select distinct CNTRY
from bronze.erp_loc101
where CNTRY not in ('US', 'USA', 'DE', '')
   or CNTRY is null;


